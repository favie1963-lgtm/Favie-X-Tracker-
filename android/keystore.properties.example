# Copy to android/keystore.properties and fill in before building a signed
# release. The real file is gitignored; never commit it or the keystore.
#
#   keytool -genkeypair -v -keystore android/favie-release.jks \
#     -alias favie -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=Favie X Tracker, O=Favie, C=US"
#
storeFile=favie-release.jks
storePassword=changeme
keyAlias=favie
keyPassword=changeme
