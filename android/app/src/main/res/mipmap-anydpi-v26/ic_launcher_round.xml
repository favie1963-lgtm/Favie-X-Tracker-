<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon. The monochrome layer lets Android 13+ tint the mark to the
  user's wallpaper theme. Its art is the same silhouette as the foreground, so
  it points at the same resource rather than duplicating the bitmap; the
  platform applies the mask and the tint itself.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
