<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for the capture foreground service.

  A notification small icon is drawn as an alpha mask and tinted by the system, so
  it must be a solid silhouette: the framework icon that was used before
  (android.R.drawable.ic_menu_view) is a multi-colour asset and renders as an
  opaque square on many devices. This is the app's mask mark with the eyes knocked
  out, so it is one shape with two clear holes and still reads at 16dp. The red eyes
  of the launcher icon cannot survive here — the system replaces every colour with
  the same tint — so the silhouette carries the mark instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M8.25,3 L15.75,3 A5.25,5.25 0 0 1 21,8.25 L21,15.75 A5.25,5.25 0 0 1 15.75,21 L8.25,21 A5.25,5.25 0 0 1 3,15.75 L3,8.25 A5.25,5.25 0 0 1 8.25,3 Z M9.6,7.8 A1.8,1.8 0 1 0 9.6,11.4 A1.8,1.8 0 1 0 9.6,7.8 Z M14.4,7.8 A1.8,1.8 0 1 0 14.4,11.4 A1.8,1.8 0 1 0 14.4,7.8 Z" />
    <path
        android:fillColor="#FFFFFFFF"
