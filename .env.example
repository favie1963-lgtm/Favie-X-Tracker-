# Runtime configuration (desktop / development)
#
# The Android APK performs capture and analysis on-device and does not use a
# backend. These values mirror the defaults in src/services/vision/config.js and
# src/services/analytics.

CAPTURE_INTERVAL=500
OUTPUT_FORMAT=json
ENABLE_AI_ANALYSIS=true
STORAGE_PATH=./data
DEBUG_MODE=false

# Object detection tuning (keep in sync with src/services/vision/config.js)
MIN_DETECTION_AREA=100
MAX_CUPS=3
FRAME_HISTORY_SIZE=30
CUP_TRACKING_MAX_FPS=4

# Frame transport (keep in sync with DEFAULT_CONFIG in src/services/tracking.js)
MAX_FRAME_WIDTH=960
JPEG_QUALITY=70
